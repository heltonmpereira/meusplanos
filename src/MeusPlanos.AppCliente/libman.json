{
  "version": "1.0",
  "defaultProvider": "cdnjs",
  "libraries": [
    {
      "library": "admin-lte@3.2.0",
      "destination": "wwwroot/lib/admin-lte/",
      "files": [
        "js/adminlte.min.js",
        "css/adminlte.min.css"
      ]
    },
    {
      "library": "jquery.mask@1.14.16",
      "destination": "wwwroot/lib/jquery.mask/"
    },
    {
      "library": "jquery@3.7.1",
      "destination": "wwwroot/lib/jquery/",
      "files": [
        "jquery.min.js"
      ]
    },
    {
      "library": "bootstrap@5.3.8",
      "destination": "wwwroot/lib/bootstrap/",
      "files": [
        "css/bootstrap-reboot.min.css",
        "css/bootstrap.min.css",
        "js/bootstrap.min.js"
      ]
    },
    {
      "library": "font-awesome@7.3.1",
      "destination": "wwwroot/lib/font-awesome/",
      "files": [
        "js/all.js",
        "js/all.min.js",
        "js/fontawesome.min.js",
        "js/brands.min.js",
        "js/solid.min.js",
        "css/all.css",
        "css/all.min.css",
        "css/brands.min.css",
        "css/solid.min.css",
        "css/v5-font-face.min.css",
        "webfonts/fa-solid-900.woff2",
        "webfonts/fa-regular-400.woff2"
      ]

    },
    {
      "library": "highlight.js@11.12.0",
      "destination": "wwwroot/lib/highlight.js/",
      "files": [
        "highlight.min.js",
        "styles/tokyo-night-light.min.css",
        "styles/default.min.css"
      ]
    },
    {
      "library": "jqueryui@1.14.2",
      "destination": "wwwroot/lib/jqueryui/",
      "files": [
        "jquery-ui.min.js",
        "themes/hot-sneaks/jquery-ui.css"
      ]
    },
    {
      "library": "summernote@0.9.1",
      "destination": "wwwroot/lib/summernote",
      "files": [
        "summernote-bs5.min.css",
        "summernote-bs5.min.js",
        "font/summernote.ttf",
        "font/summernote.eot",
        "font/summernote.woff",
        "font/summernote.woff2"
      ]
    },
    {
      "provider": "jsdelivr",
      "library": "netstack.js@2.1.4",
      "destination": "wwwroot/lib/netstack.js/",
      "files": [
        "netstack.js"
      ]
    },
    {
      "provider": "jsdelivr",
      "library": "jquery-validation@1.22.1",
      "destination": "wwwroot/lib/jquery-validation/",
      "files": [
        "dist/jquery.validate.min.js",
        "dist/additional-methods.min.js"
      ]
    }
  ]
}