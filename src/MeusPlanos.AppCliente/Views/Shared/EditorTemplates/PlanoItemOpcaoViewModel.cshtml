
@model MeusPlanos.AppCliente.ViewModel.PlanoItemOpcaoViewModel

<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<input type="hidden" asp-for="Id" />
<input type="hidden" asp-for="PlanoItemId" />

<div class="row">
    <div class="form-group col-sm-6">
        <label asp-for="Nome" class="control-label"></label>
        <input asp-for="Nome" class="form-control" maxlength="200" />
        <span asp-validation-for="Nome" class="text-danger"></span>
    </div>
    <div class="form-group col-sm-6">
        <label asp-for="Ordem" class="control-label"></label>
        <input asp-for="Ordem" class="form-control" type="number" min="0" />
        <span asp-validation-for="Ordem" class="text-danger"></span>
    </div>
</div>
<div class="row">
    <div class="form-group col-sm-12">
        <label asp-for="Descricao" class="control-label"></label>
        <textarea asp-for="Descricao" class="form-control" maxlength="2000" rows="2"></textarea>
        <span asp-validation-for="Descricao" class="text-danger"></span>
    </div>
</div>
<div class="row">
    <div class="form-group col-sm-12">
        <label asp-for="Caracteristicas" class="control-label"></label>
        <textarea asp-for="Caracteristicas" class="form-control" maxlength="4000" rows="5"></textarea>
        <span asp-validation-for="Caracteristicas" class="text-danger"></span>
    </div>
</div>

<div class="row">
    <div class="form-group">
        <hr />
        <input asp-acessando-como type="submit" value="Salvar" class="btn btn-primary" />

        @if (Model.PlanoItemId != Guid.Empty)
        {
            <a class="btn @(ViewBag.ClasseBotao)secondary" asp-action="Index" asp-route-PlanoItemId="@Model.PlanoItemId" asp-controller="PlanoItemOpcao">Voltar</a>
        }
        else
        {
            <a class="btn @(ViewBag.ClasseBotao)secondary" asp-action="Index">Voltar</a>
        }
    </div>
</div>
