
@using Microsoft.Extensions.Configuration
@inject IConfiguration Configuration
@model MeusPlanos.AppCliente.ViewModel.PlanoItemOpcaoLinkViewModel

@{
    var baseUrlApi = Configuration["BaseUrlApi"]?.TrimEnd('/');
    var imagensExistentes = Model?.ImagensLinks
        ?.OrderBy(o => o.Ordem)
        .ToList() ?? new List<MeusPlanos.AppCliente.ViewModel.PlanoItemOpcaoLinkImagemViewModel>();
    var galeriaTheme = ViewBag.Theme == "dark" ? "galeria-container-dark" : "galeria-container-light";
}

<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<input type="hidden" asp-for="Id" />
<input type="hidden" asp-for="PlanoItemOpcaoId" />

<div class="row">
    <div class="form-group col-sm-8">
        <label asp-for="Url" class="control-label"></label>
        <input asp-for="Url" class="form-control" maxlength="1000" placeholder="https://..." />
        <span asp-validation-for="Url" class="text-danger"></span>
    </div>
    <div class="form-group col-sm-4">
        <label asp-for="NomeSite" class="control-label"></label>
        <input asp-for="NomeSite" class="form-control" maxlength="200" />
        <span asp-validation-for="NomeSite" class="text-danger"></span>
    </div>
</div>
<div class="row">
    <div class="form-group col-sm-4">
        <label asp-for="Valor" class="control-label"></label>
        <input asp-for="Valor" class="form-control" type="number" step="0.01" min="0" />
        <span asp-validation-for="Valor" class="text-danger"></span>
    </div>
    <div class="form-group col-sm-4">
        <label asp-for="DataCotacao" class="control-label"></label>
        <input asp-for="DataCotacao" class="form-control" type="datetime-local" />
        <span asp-validation-for="DataCotacao" class="text-danger"></span>
    </div>
</div>
<div class="row">
    <div class="form-group col-sm-12">
        <label asp-for="CondicoesPagamento" class="control-label"></label>
        <textarea asp-for="CondicoesPagamento" class="form-control" maxlength="2000" rows="3"></textarea>
        <span asp-validation-for="CondicoesPagamento" class="text-danger"></span>
    </div>
</div>
<div class="row">
    <div class="form-group col-sm-12">
        <label asp-for="Observacoes" class="control-label"></label>
        <textarea asp-for="Observacoes" class="form-control" maxlength="4000" rows="4"></textarea>
        <span asp-validation-for="Observacoes" class="text-danger"></span>
    </div>
</div>

<div class="row">
    <div class="form-group col-sm-12">
        <label class="control-label">Galeria de Imagens</label>
        <div class="card @ViewBag.ClasseCard galeria-wrapper" data-hidden-ordem="hidden_OrdemImagensLink">
            <div class="card-body p-3">
                <div class="row mb-3">
                    <div class="col-8">
                        <input id="input_galeria_link" type="file" accept="image/*" multiple
                               class="form-control form-control-sm arquivo-upload-galeria"
                               data-url-upload="@Url.Action("UploadImagem", "UploadImagem")" />
                    </div>
                    <div class="col-4">
                        <button type="button"
                                class="btn @(ViewBag.ClasseBotao)info btn-enviar-galeria w-100"
                                data-input="input_galeria_link"
                                data-container="galeria_container_link"
                                data-hidden-ordem="hidden_OrdemImagensLink"
                                data-link-id="@(Model?.Id == Guid.Empty ? null : Model?.Id.ToString())">
                            <i class="fas fa-upload"></i> Adicionar
                        </button>
                    </div>
                </div>

                <div id="galeria_container_link" class="border rounded p-2 @galeriaTheme">
                    @foreach (var li in imagensExistentes)
                    {
                        var img = li?.Imagem;
                        var url = img != null && !string.IsNullOrWhiteSpace(img.CaminhoRelativo)
                            ? $"{baseUrlApi}/uploads/imagens/{img.CaminhoRelativo.Replace('\\', '/')}"
                            : null;
                        <div class="galeria-item card mb-2 mr-2 d-inline-block galeria-item-card @(li.EhCapa ? "border-primary border-2" : "")"
                             data-id="@img?.Id"
                             data-link-imagem-id="@li?.Id">
                            <div class="p-1">
                                <div class="border rounded overflow-hidden galeria-thumb-box">
                                    @if (!string.IsNullOrWhiteSpace(url))
                                    {
                                        <img src="@url" class="img-fluid galeria-thumb-img">
                                    }
                                </div>
                                <div class="pt-2 small">
                                    @if (li.EhCapa)
                                    {
                                        <span class="badge bg-primary mb-1"><i class="fas fa-star"></i> Capa</span>
                                    }
                                    <div class="text-truncate" title="@img?.NomeOriginal">@img?.NomeOriginal</div>
                                </div>
                                <div class="btn-group btn-group-sm mt-1 d-flex" role="group">
                                    <button type="button" class="btn btn-outline-primary btn-galeria-capa" title="Definir como capa"><i class="fas fa-star"></i></button>
                                    <button type="button" class="btn btn-outline-secondary btn-galeria-subir" title="Mover para cima"><i class="fas fa-arrow-up"></i></button>
                                    <button type="button" class="btn btn-outline-secondary btn-galeria-descer" title="Mover para baixo"><i class="fas fa-arrow-down"></i></button>
                                    <button type="button" class="btn btn-outline-danger btn-galeria-remover" title="Remover"><i class="fas fa-times"></i></button>
                                </div>
                                <input type="hidden" class="gi-id" name="GaleriaImagensIds[]" value="@img?.Id" />
                                <input type="hidden" class="gi-linkimagemid" name="GaleriaLinkImagemIds[]" value="@li?.Id" />
                                <input type="hidden" class="gi-ordem" name="GaleriaOrdens[]" value="@li.Ordem" />
                                <input type="hidden" class="gi-capa" name="GaleriaCapas[]" value="@(li.EhCapa ? "true" : "false")" />
                            </div>
                        </div>
                    }
                </div>
                <input type="hidden" id="hidden_OrdemImagensLink" name="OrdemImagensIds" value="" />
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="form-group">
        <hr />
        <input asp-acessando-como type="submit" value="Salvar" class="btn btn-primary" />

        @if (Model.PlanoItemOpcaoId != Guid.Empty)
        {
            <a class="btn @(ViewBag.ClasseBotao)secondary" asp-action="Index" asp-route-PlanoItemOpcaoId="@Model.PlanoItemOpcaoId" asp-controller="PlanoItemOpcaoLink">Voltar</a>
        }
        else
        {
            <a class="btn @(ViewBag.ClasseBotao)secondary" asp-action="Index">Voltar</a>
        }
    </div>
</div>
