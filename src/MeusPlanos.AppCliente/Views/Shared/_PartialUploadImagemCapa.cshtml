@using Microsoft.Extensions.Configuration
@inject IConfiguration Configuration
@{
    var campoPrefixo = ViewData["Prefixo"]?.ToString() ?? "";
    var campoIdNome = ViewData["CampoId"]?.ToString() ?? "ImagemCapaId";
    var label = ViewData["Label"]?.ToString() ?? "Imagem de Capa";
    var baseUrlApi = Configuration["BaseUrlApi"]?.TrimEnd('/');

    var fullIdCampo = string.IsNullOrWhiteSpace(campoPrefixo) ? campoIdNome : $"{campoPrefixo}_{campoIdNome}";
    var fullNameCampo = string.IsNullOrWhiteSpace(campoPrefixo) ? campoIdNome : $"{campoPrefixo}.{campoIdNome}";

    // Obter valores via ViewData (campo passado explicitamente)
    var imagemId = ViewData["ImagemId"]?.ToString();
    var imagemUrl = ViewData["ImagemUrl"] as string;
    var imagemNome = ViewData["ImagemNome"] as string;
    var imagemTamanho = ViewData["ImagemTamanho"] as string;

    var inputFileId = $"upload_{fullIdCampo}";
}

<div class="form-group col-sm-12 col-md-6">
    <label class="control-label">@label</label>
    <div class="card mb-3 @ViewBag.ClasseCard">
        <div class="card-body p-3">
            <div class="row align-items-center">
                <div class="col-4">
                    <div id="preview_@inputFileId"
                         class="border rounded d-flex align-items-center justify-content-center overflow-hidden"
                         style="height:140px;width:100%; @(ViewBag.Theme == "dark" ? "background:#1f2937;border-color:#374151 !important;" : "background:#f8f9fa;")">
                        @if (!string.IsNullOrWhiteSpace(imagemUrl))
                        {
                            <img src="@imagemUrl" alt="pré-visualização" class="img-fluid" style="max-height:140px;object-fit:cover;" />
                        }
                        else
                        {
                            <span class="text-muted small">sem imagem</span>
                        }
                    </div>
                </div>
                <div class="col-8">
                    <input id="@inputFileId" type="file" accept="image/*"
                           class="form-control form-control-sm mb-2 arquivo-upload-capa"
                           data-campo-id="@fullIdCampo"
                           data-preview="preview_@inputFileId"
                           data-url-upload="@Url.Action("UploadImagem", "UploadImagem")" />

                    <input type="hidden" id="hidden_@fullIdCampo" name="@fullNameCampo" value="@imagemId" />

                    <div id="info_@inputFileId" class="small text-muted mb-2">
                        @if (!string.IsNullOrWhiteSpace(imagemNome))
                        {
                            <span>@imagemNome</span>
                            if (!string.IsNullOrWhiteSpace(imagemTamanho))
                            {
                                <span class="mx-1">·</span>
                                <span>@imagemTamanho</span>
                            }
                        }
                    </div>

                    <div class="d-flex gap-2 flex-wrap">
                        <button type="button"
                                class="btn btn-sm @(ViewBag.ClasseBotao)info btn-enviar-imagem"
                                data-input="@inputFileId">
                            <i class="fas fa-upload"></i> Enviar
                        </button>
                        <button type="button"
                                class="btn btn-sm @(ViewBag.ClasseBotao)danger btn-remover-imagem"
                                data-input="@inputFileId"
                                data-campo-id="hidden_@fullIdCampo"
                                data-preview="preview_@inputFileId"
                                data-info="info_@inputFileId">
                            <i class="fas fa-times"></i> Remover
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <span class="text-danger field-validation-valid" data-valmsg-for="@fullNameCampo" data-valmsg-replace="true"></span>
</div>
