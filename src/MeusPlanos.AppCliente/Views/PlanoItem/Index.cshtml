
@using Microsoft.Extensions.Configuration
@inject IConfiguration Configuration
@using MeusPlanos.AppCliente.Models.Interface;
@model ListaBaseViewModel<PlanoItemViewModel>

@{
    ViewData["Title"] = "Itens do Plano";
    ViewData["Icone"] = "<i class='fa fa-lg fa-list-check'></i>";
    var planoId = Context.Request.Query["PlanoId"].FirstOrDefault();
    var routeNovo = planoId != null ? new { PlanoId = planoId } : null;
    ViewData["LinkNovo"] = Url.Action("Incluir", routeNovo);

    string BaseUrl() => Configuration["BaseUrlApi"]?.TrimEnd('/');
    string ImgUrl(string cam) => string.IsNullOrWhiteSpace(cam) || string.IsNullOrWhiteSpace(BaseUrl())
        ? null : $"{BaseUrl()}/uploads/imagens/{cam.Replace('\\', '/')}";

    var filtro = Model == null ? null : Model.FiltroViewModel;
    await Html.RenderPartialAsync("_PartialFiltro", filtro);

    @section Scripts {
        <script nws-csp-add-nonce="true" asp-append-version="true" src="~/js/views/paginacao.js"></script>
        <script nws-csp-add-nonce="true" asp-append-version="true" type="text/javascript">
            document.addEventListener('keydown',
                (event) => {
                    if (event.code === "KeyN") {
                        window.location.href = '@Url.Action("Incluir", routeNovo)';
                    }
                });
        </script>
    }
}

<div class="col-11 px-sm-3 px-md-0 pt-4 mx-auto">
    @if (!string.IsNullOrWhiteSpace(planoId))
    {
        <div class="mb-3">
            <a class="btn @(ViewBag.ClasseBotao)secondary" asp-action="Detalhes" asp-controller="Plano" asp-route-id="@planoId">
                <i class="fa-solid fa-arrow-left"></i> Voltar ao Plano
            </a>
        </div>
    }

    <h1>Itens do Plano</h1>
    <hr />
</div>

@if ((ViewBag?.RetornoApi == null || ViewBag?.RetornoApi.BemSucedido) && (Model == null || !Model.Itens.Any()))
{
    await Html.RenderPartialAsync(
        "_PartialAlertaVazio",
        new Tuple<ICriterioViewModel, string, object>(filtro, "Item do Plano", routeNovo));
}
else if (Model != null && Model.Itens != null && Model.Itens.Any())
{
    var tableTheme = $"table-{ViewBag.Theme}";
    var classBotao = ViewBag.Theme == "dark" ? string.Empty : "-outline";

    <div class="table-responsive col-11 px-sm-3 px-md-0 pt-2 mx-auto">
        <table class="table table-striped table-hover table-valign-middle @tableTheme">
            <thead class="table-primary">
                <tr>
                    <th style="width:72px;">Capa</th>
                    <th>
                        <asp-cabecalho asp-for="Itens.FirstOrDefault().Ordem"/>
                    </th>
                    <th>
                        <asp-cabecalho asp-for="Itens.FirstOrDefault().Nome"/>
                    </th>
                    <th>
                        <asp-cabecalho asp-for="Itens.FirstOrDefault().ValorOrcamentoEstimado"/>
                    </th>
                    <th>
                        <asp-cabecalho asp-for="Itens.FirstOrDefault().Descricao"/>
                    </th>
                    <th colspan="5">Ações</th>
                </tr>
            </thead>
            <tbody class="table-group-divider">
                @foreach (var item in Model.Itens)
                {
                    var capa = ImgUrl(item?.ImagemCapa?.CaminhoRelativo);
                    <tr class="align-middle">
                        <td class="p-1 text-center">
                            @if (!string.IsNullOrWhiteSpace(capa))
                            {
                                <img src="@capa" class="img-fluid rounded border" style="max-width:60px;max-height:40px;object-fit:cover;" />
                            }
                            else
                            {
                                <span class="text-muted small"><i class="fa-regular fa-image fa-lg"></i></span>
                            }
                        </td>
                        <td>@Html.DisplayFor(modelItem => item.Ordem)</td>
                        <td>@Html.DisplayFor(modelItem => item.Nome)</td>
                        <td>@Html.DisplayFor(modelItem => item.ValorOrcamentoEstimado)</td>
                        <td>@Html.DisplayFor(modelItem => item.Descricao)</td>
                        <td class="p-2 align-content-center w250px">
                            <div class="btn-group" role="group" aria-label="Botões de ação">
                                <a title="Gerenciar Opções" class="btn btn@(classBotao)-info btn-acao p-0 pt-1 pb-1" asp-action="Index" asp-controller="PlanoItemOpcao" asp-route-PlanoItemId="@item.Id">
                                    <i class="fa-solid fa-lg fa-layer-group"></i>
                                </a>
                                <a title="Nova Opção" class="btn btn@(classBotao)-secondary btn-acao p-0 pt-1 pb-1" asp-action="Incluir" asp-controller="PlanoItemOpcao" asp-route-PlanoItemId="@item.Id">
                                    <i class="fa-solid fa-lg fa-plus"></i>
                                </a>
                                <a title="Alterar" class="btn btn@(classBotao)-primary btn-acao p-0 pt-1 pb-1" asp-action="Alterar" asp-route-id="@item.Id">
                                    <i class="fa-solid fa-lg fa-pen-to-square"></i>
                                </a>
                                <a title="Detalhes" class="btn btn@(classBotao)-success btn-acao p-0 pt-1 pb-1" asp-action="Detalhes" asp-route-id="@item.Id">
                                    <i class="fa-solid fa-lg fa-info-circle"></i>
                                </a>
                                <a possui-papel="superadmin" title="Remover" class="btn btn@(classBotao)-danger btn-acao p-0 pt-1 pb-1" asp-action="Deletar" asp-route-id="@item.Id">
                                    <i class="fa-solid fa-lg fa-trash-can"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    await Html.RenderPartialAsync("_PartialPaginacao", Model.Itens);
}
