
@model MeusPlanos.AppCliente.ViewModel.PlanoItemViewModel

@{
    ViewData["Title"] = "Item do Plano";
    ViewData["Icone"] = "<i class='fa fa-list-check fa-lg text-primary'></i>";

    @section Scripts {
        @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
        }
    }
}

<div class="col-11 px-sm-3 px-md-0 pt-4 mx-auto">
    <h1>Detalhes do Item</h1>

    @Html.DisplayFor(model => model)

    <div class="mt-4 mb-3">
        <a class="btn btn-primary" asp-action="Index" asp-controller="PlanoItemOpcao" asp-route-PlanoItemId="@Model.Id">
            <i class="fa-solid fa-layer-group"></i> Gerenciar Opções
        </a>
        <a class="btn @(ViewBag.ClasseBotao)success" asp-action="Incluir" asp-controller="PlanoItemOpcao" asp-route-PlanoItemId="@Model.Id">
            <i class="fa-solid fa-plus"></i> Nova Opção
        </a>
    </div>

    @if (Model.Opcoes != null && Model.Opcoes.Any())
    {
        var tableTheme = $"table-{ViewBag.Theme}";
        var classBotao = ViewBag.Theme == "dark" ? string.Empty : "-outline";

        <h2 class="mt-4">Opções do Item</h2>
        <hr />
        <div class="table-responsive">
            <table class="table table-striped table-hover table-valign-middle @tableTheme">
                <thead class="table-info">
                    <tr>
                        <th>Ordem</th>
                        <th>Nome</th>
                        <th>Descrição</th>
                        <th>Qtd Links</th>
                        <th class="w150px">Ações</th>
                    </tr>
                </thead>
                <tbody class="table-group-divider">
                    @foreach (var opcao in Model.Opcoes.OrderBy(o => o.Ordem).ThenBy(o => o.Nome))
                    {
                        <tr class="align-middle">
                            <td>@opcao.Ordem</td>
                            <td>@opcao.Nome</td>
                            <td>@opcao.Descricao</td>
                            <td>@(opcao.Links?.Count ?? 0)</td>
                            <td>
                                <div class="btn-group" role="group">
                                    <a title="Links" class="btn btn@(classBotao)-info btn-acao p-0 pt-1 pb-1" asp-action="Index" asp-controller="PlanoItemOpcaoLink" asp-route-PlanoItemOpcaoId="@opcao.Id">
                                        <i class="fa-solid fa-link"></i>
                                    </a>
                                    <a title="Alterar" class="btn btn@(classBotao)-primary btn-acao p-0 pt-1 pb-1" asp-action="Alterar" asp-controller="PlanoItemOpcao" asp-route-id="@opcao.Id">
                                        <i class="fa-solid fa-pen-to-square"></i>
                                    </a>
                                    <a title="Detalhes" class="btn btn@(classBotao)-success btn-acao p-0 pt-1 pb-1" asp-action="Detalhes" asp-controller="PlanoItemOpcao" asp-route-id="@opcao.Id">
                                        <i class="fa-solid fa-info-circle"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <hr />
    @if (Model.PlanoId != Guid.Empty)
    {
        <a class="btn @(ViewBag.ClasseBotao)secondary" asp-action="Index" asp-route-PlanoId="@Model.PlanoId">Voltar</a>
    }
    else
    {
        <a class="btn @(ViewBag.ClasseBotao)secondary" asp-action="Index">Voltar</a>
    }
</div>
