
@model MeusPlanos.AppCliente.ViewModel.PlanoItemViewModel

@{
    ViewData["Title"] = "Item do Plano";
    ViewData["Icone"] = "<i class='fa fa-list-check fa-lg text-primary'></i>";
    @section Scripts {
        @{
            await Html.RenderPartialAsync("_ValidationScriptsPartial");
        }
        <script src="~/js/upload-imagem.js" asp-append-version="true"></script>
    }
}

<form asp-action="Incluir" method="post" class="col-11 px-sm-3 px-md-0 pt-4 mx-auto">
    <h1>Cadastrar Item</h1>
    <hr />

    @Html.EditorForModel()
</form>
