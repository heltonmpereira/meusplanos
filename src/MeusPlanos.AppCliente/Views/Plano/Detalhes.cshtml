
@model MeusPlanos.AppCliente.ViewModel.PlanoViewModel

@{
    ViewData["Title"] = "Plano";
    ViewData["Icone"] = "<i class='fa fa-home fa-lg text-primary'></i>";

    @section Scripts {
        @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
        }
    }
}

<div class="col-11 px-sm-3 px-md-0 pt-4 mx-auto">
    <h1>Detalhes</h1>

    @Html.DisplayFor(model => model)

    <div class="mt-4 mb-3">
        <a class="btn btn-primary" asp-action="Index" asp-controller="PlanoItem" asp-route-PlanoId="@Model.Id">
            <i class="fa-solid fa-list-check"></i> Gerenciar Itens
        </a>
        <a class="btn @(ViewBag.ClasseBotao)success" asp-action="Incluir" asp-controller="PlanoItem" asp-route-PlanoId="@Model.Id">
            <i class="fa-solid fa-plus"></i> Novo Item
        </a>
    </div>

    @if (Model.Itens != null && Model.Itens.Any())
    {
        var tableTheme = $"table-{ViewBag.Theme}";
        var classBotao = ViewBag.Theme == "dark" ? string.Empty : "-outline";

        decimal totalOrcamento = 0;
        foreach (var it in Model.Itens)
            totalOrcamento += it.ValorOrcamentoEstimado;

        <h2 class="mt-4">Itens do Plano <small class="text-muted">(Total Orçado: @totalOrcamento.ToString("C"))</small></h2>
        <hr />
        <div class="table-responsive">
            <table class="table table-striped table-hover table-valign-middle @tableTheme">
                <thead class="table-info">
                    <tr>
                        <th>Ordem</th>
                        <th>Nome</th>
                        <th>Descrição</th>
                        <th>Orçamento Estimado</th>
                        <th>Opções</th>
                        <th class="w200px">Ações</th>
                    </tr>
                </thead>
                <tbody class="table-group-divider">
                    @foreach (var item in Model.Itens.OrderBy(o => o.Ordem).ThenBy(o => o.Nome))
                    {
                        <tr class="align-middle">
                            <td>@item.Ordem</td>
                            <td>@item.Nome</td>
                            <td>@item.Descricao</td>
                            <td>@Html.DisplayFor(_ => item.ValorOrcamentoEstimado)</td>
                            <td>@(item.Opcoes?.Count ?? 0)</td>
                            <td>
                                <div class="btn-group" role="group">
                                    <a title="Opções" class="btn btn@(classBotao)-info btn-acao p-0 pt-1 pb-1" asp-action="Index" asp-controller="PlanoItemOpcao" asp-route-PlanoItemId="@item.Id">
                                        <i class="fa-solid fa-layer-group"></i>
                                    </a>
                                    <a title="Alterar" class="btn btn@(classBotao)-primary btn-acao p-0 pt-1 pb-1" asp-action="Alterar" asp-controller="PlanoItem" asp-route-id="@item.Id">
                                        <i class="fa-solid fa-pen-to-square"></i>
                                    </a>
                                    <a title="Detalhes" class="btn btn@(classBotao)-success btn-acao p-0 pt-1 pb-1" asp-action="Detalhes" asp-controller="PlanoItem" asp-route-id="@item.Id">
                                        <i class="fa-solid fa-info-circle"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <hr />
    <a class="btn @(ViewBag.ClasseBotao)secondary" asp-action="Index">Voltar</a>
</div>
