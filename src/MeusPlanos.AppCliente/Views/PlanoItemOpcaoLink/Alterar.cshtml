
@model MeusPlanos.AppCliente.ViewModel.PlanoItemOpcaoLinkViewModel

@{
    ViewData["Title"] = "Link / Oferta";
    ViewData["Icone"] = "<i class='fa fa-link fa-lg text-primary'></i>";

    @section Scripts {
        @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
        }
        <script src="~/js/upload-imagem.js" asp-append-version="true"></script>
        <script nws-csp-add-nonce="true" type="text/javascript">
            (function () {
                var frm = document.querySelector('form');
                if (frm) {
                    frm.addEventListener('submit', function () {
                        var ids = [];
                        document.querySelectorAll('#galeria_container_link .galeria-item').forEach(function (el, i) {
                            var hOrdem = el.querySelector('.gi-ordem'); if (hOrdem) hOrdem.value = String(i);
                            ids.push(el.getAttribute('data-id'));
                        });
                        var h = document.getElementById('hidden_OrdemImagensLink');
                        if (h) h.value = JSON.stringify(ids);
                    });
                }
            })();
        </script>
    }
}

<form asp-action="Alterar" method="post" class="col-11 px-sm-3 px-md-0 pt-4 mx-auto">
    <h1>Alterar Link / Oferta</h1>
    <hr />

    @Html.EditorForModel()
</form>
