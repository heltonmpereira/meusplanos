
@using Microsoft.Extensions.Configuration
@inject IConfiguration Configuration
@using MeusPlanos.AppCliente.Models.Interface;
@model ListaBaseViewModel<PlanoItemOpcaoLinkViewModel>

@{
    ViewData["Title"] = "Links / Ofertas";
    ViewData["Icone"] = "<i class='fa fa-lg fa-link'></i>";
    var opcaoId = Context.Request.Query["PlanoItemOpcaoId"].FirstOrDefault();
    var routeNovo = opcaoId != null ? new { PlanoItemOpcaoId = opcaoId } : null;
    ViewData["LinkNovo"] = Url.Action("Incluir", routeNovo);

    string BaseUrl() => Configuration["BaseUrlApi"]?.TrimEnd('/');
    string ImgUrl(string cam) => string.IsNullOrWhiteSpace(cam) || string.IsNullOrWhiteSpace(BaseUrl())
        ? null : $"{BaseUrl()}/uploads/imagens/{cam.Replace('\\', '/')}";

    var filtro = Model == null ? null : Model.FiltroViewModel;
    await Html.RenderPartialAsync("_PartialFiltro", filtro);

    @section Scripts {
        <script nws-csp-add-nonce="true" asp-append-version="true" src="~/js/views/paginacao.js"></script>
        <script nws-csp-add-nonce="true" asp-append-version="true" type="text/javascript">
            document.addEventListener('keydown',
                (event) => {
                    if (event.code === "KeyN") {
                        window.location.href = '@Url.Action("Incluir", routeNovo)';
                    }
                });
        </script>
    }
}

<div class="col-11 px-sm-3 px-md-0 pt-4 mx-auto">
    @if (!string.IsNullOrWhiteSpace(opcaoId))
    {
        <div class="mb-3">
            <a class="btn @(ViewBag.ClasseBotao)secondary" asp-action="Detalhes" asp-controller="PlanoItemOpcao" asp-route-id="@opcaoId">
                <i class="fa-solid fa-arrow-left"></i> Voltar à Opção
            </a>
        </div>
    }

    <h1>Links / Ofertas</h1>
    <hr />
</div>

@if ((ViewBag?.RetornoApi == null || ViewBag?.RetornoApi.BemSucedido) && (Model == null || !Model.Itens.Any()))
{
    await Html.RenderPartialAsync(
        "_PartialAlertaVazio",
        new Tuple<ICriterioViewModel, string, object>(filtro, "Link/Oferta", routeNovo));
}
else if (Model != null && Model.Itens != null && Model.Itens.Any())
{
    var tableTheme = $"table-{ViewBag.Theme}";
    var classBotao = ViewBag.Theme == "dark" ? string.Empty : "-outline";

    <div class="table-responsive col-11 px-sm-3 px-md-0 pt-2 mx-auto">
        <table class="table table-striped table-hover table-valign-middle @tableTheme">
            <thead class="table-primary">
                <tr>
                    <th class="w-72px">Capa</th>
                    <th>
                        <asp-cabecalho asp-for="Itens.FirstOrDefault().NomeSite"/>
                    </th>
                    <th>
                        <asp-cabecalho asp-for="Itens.FirstOrDefault().Valor"/>
                    </th>
                    <th>
                        <asp-cabecalho asp-for="Itens.FirstOrDefault().DataCotacao"/>
                    </th>
                    <th>
                        <asp-cabecalho asp-for="Itens.FirstOrDefault().CondicoesPagamento"/>
                    </th>
                    <th class="w-90px">Imagens</th>
                    <th colspan="3">Ações</th>
                </tr>
            </thead>
            <tbody class="table-group-divider">
                @foreach (var item in Model.Itens)
                {
                    var primImg = item.ImagensLinks?
                        .OrderBy(i => i.Ordem)
                        .FirstOrDefault(i => i.EhCapa)
                        ?? item.ImagensLinks?.OrderBy(i => i.Ordem).FirstOrDefault();
                    var capa = ImgUrl(primImg?.Imagem?.CaminhoRelativo);
                    var qtd = item.ImagensLinks?.Count ?? 0;
                    <tr class="align-middle">
                        <td class="p-1 text-center">
                            @if (!string.IsNullOrWhiteSpace(capa))
                            {
                                <img src="@capa" class="img-fluid rounded border img-thumb-index" />
                            }
                            else
                            {
                                <span class="text-muted small"><i class="fa-regular fa-image fa-lg"></i></span>
                            }
                        </td>
                        <td>@Html.DisplayFor(modelItem => item.NomeSite)</td>
                        <td>@Html.DisplayFor(modelItem => item.Valor)</td>
                        <td>@Html.DisplayFor(modelItem => item.DataCotacao)</td>
                        <td>@Html.DisplayFor(modelItem => item.CondicoesPagamento)</td>
                        <td>
                            @if (qtd > 0)
                            {
                                <span class="badge @(ViewBag.ClasseBotao)info" title="@qtd imagem/ens na galeria">
                                    <i class="fa-regular fa-images"></i> @qtd
                                </span>
                            }
                        </td>
                        <td class="p-2 align-content-center w150px">
                            <div class="btn-group" role="group" aria-label="Botões de ação">
                                @if (!string.IsNullOrWhiteSpace(item.Url))
                                {
                                    <a title="Abrir Site" class="btn btn@(classBotao)-info btn-acao p-0 pt-1 pb-1" href="@item.Url" target="_blank" rel="noopener noreferrer">
                                        <i class="fa-solid fa-lg fa-arrow-up-right-from-square"></i>
                                    </a>
                                }
                                <a title="Alterar" class="btn btn@(classBotao)-primary btn-acao p-0 pt-1 pb-1" asp-action="Alterar" asp-route-id="@item.Id">
                                    <i class="fa-solid fa-lg fa-pen-to-square"></i>
                                </a>
                                <a title="Detalhes" class="btn btn@(classBotao)-success btn-acao p-0 pt-1 pb-1" asp-action="Detalhes" asp-route-id="@item.Id">
                                    <i class="fa-solid fa-lg fa-info-circle"></i>
                                </a>
                                <a possui-papel="superadmin" title="Remover" class="btn btn@(classBotao)-danger btn-acao p-0 pt-1 pb-1" asp-action="Deletar" asp-route-id="@item.Id">
                                    <i class="fa-solid fa-lg fa-trash-can"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    await Html.RenderPartialAsync("_PartialPaginacao", Model.Itens);
}
