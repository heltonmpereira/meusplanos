
@model MeusPlanos.AppCliente.ViewModel.PlanoItemOpcaoViewModel

@{
    ViewData["Title"] = "Opção do Item";
    ViewData["Icone"] = "<i class='fa fa-layer-group fa-lg text-primary'></i>";

    @section Scripts {
        @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
        }
    }
}

<div class="col-11 px-sm-3 px-md-0 pt-4 mx-auto">
    <h1>Detalhes da Opção</h1>

    @Html.DisplayFor(model => model)

    <div class="mt-4 mb-3">
        <a class="btn btn-primary" asp-action="Index" asp-controller="PlanoItemOpcaoLink" asp-route-PlanoItemOpcaoId="@Model.Id">
            <i class="fa-solid fa-link"></i> Gerenciar Links/Ofertas
        </a>
        <a class="btn @(ViewBag.ClasseBotao)success" asp-action="Incluir" asp-controller="PlanoItemOpcaoLink" asp-route-PlanoItemOpcaoId="@Model.Id">
            <i class="fa-solid fa-plus"></i> Novo Link
        </a>
    </div>

    @if (Model.Links != null && Model.Links.Any())
    {
        var tableTheme = $"table-{ViewBag.Theme}";
        var classBotao = ViewBag.Theme == "dark" ? string.Empty : "-outline";

        <h2 class="mt-4">Links / Ofertas</h2>
        <hr />
        <div class="table-responsive">
            <table class="table table-striped table-hover table-valign-middle @tableTheme">
                <thead class="table-info">
                    <tr>
                        <th>Site</th>
                        <th>URL</th>
                        <th>Valor</th>
                        <th>Data Cotação</th>
                        <th>Cond. Pagamento</th>
                        <th class="w100px">Ações</th>
                    </tr>
                </thead>
                <tbody class="table-group-divider">
                    @foreach (var link in Model.Links.OrderByDescending(l => l.DataCotacao ?? l.DataCriacao))
                    {
                        <tr class="align-middle">
                            <td>@link.NomeSite</td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(link.Url))
                                {
                                    <a href="@link.Url" target="_blank" rel="noopener noreferrer">Abrir</a>
                                }
                            </td>
                            <td>@Html.DisplayFor(_ => link.Valor)</td>
                            <td>@Html.DisplayFor(_ => link.DataCotacao)</td>
                            <td>@link.CondicoesPagamento</td>
                            <td>
                                <div class="btn-group" role="group">
                                    <a title="Alterar" class="btn btn@(classBotao)-primary btn-acao p-0 pt-1 pb-1" asp-action="Alterar" asp-controller="PlanoItemOpcaoLink" asp-route-id="@link.Id">
                                        <i class="fa-solid fa-pen-to-square"></i>
                                    </a>
                                    <a title="Detalhes" class="btn btn@(classBotao)-success btn-acao p-0 pt-1 pb-1" asp-action="Detalhes" asp-controller="PlanoItemOpcaoLink" asp-route-id="@link.Id">
                                        <i class="fa-solid fa-info-circle"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <hr />
    @if (Model.PlanoItemId != Guid.Empty)
    {
        <a class="btn @(ViewBag.ClasseBotao)secondary" asp-action="Index" asp-route-PlanoItemId="@Model.PlanoItemId">Voltar</a>
    }
    else
    {
        <a class="btn @(ViewBag.ClasseBotao)secondary" asp-action="Index">Voltar</a>
    }
</div>
