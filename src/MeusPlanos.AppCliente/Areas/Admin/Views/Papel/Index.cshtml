@using MeusPlanos.AppCliente.Models.Interface;
@model ListaBaseViewModel<PapelViewModel>

@{
    ViewData["Title"] = "Papéis";
    ViewData["Icone"] = "<i class='fa fa-lg fa-newspaper'></i>";
    ViewData["LinkNovo"] = Url.Action("Incluir");

    var filtro = Model == null ? null : Model.FiltroViewModel;
    await Html.RenderPartialAsync("_PartialFiltro", filtro);
    @section Scripts {
        <script nws-csp-add-nonce="true" asp-append-version="true" src="~/js/views/paginacao.js"></script>
        <script nws-csp-add-nonce="true" asp-append-version="true" type="text/javascript">
            document.addEventListener('keydown',
                (event) => {
                    if (event.code === "KeyN") {
                        window.location.href = '@Url.Action("Incluir")';
                    }
                });
        </script>
    }
}

@if ((ViewBag?.RetornoApi == null || ViewBag?.RetornoApi.BemSucedido) && (Model == null || !Model.Itens.Any()))
{
    await Html.RenderPartialAsync(
    "_PartialAlertaVazio",
        new Tuple<ICriterioViewModel, string, object>(filtro, "Papéis", null));
}
else if (Model != null && Model.Itens != null && Model.Itens.Any())
{
    var tableTheme = $"table-{ViewBag.Theme}";
    var classBotao = ViewBag.Theme == "dark" ? string.Empty : "-outline";

    <div class="table-responsive col-11 px-sm-3 px-md-0 pt-4 mx-auto">
        <table class="table table-striped table-hover table-valign-middle @tableTheme">
            <thead class="table-primary">
                <tr>
                    <th>
                        <asp-cabecalho asp-for="Itens.FirstOrDefault().Nome" />
                    </th>
                    <th>
                        <asp-cabecalho asp-for="Itens.FirstOrDefault().DataCadastro" />
                    </th>
                    <th>
                        <asp-cabecalho asp-for="Itens.FirstOrDefault().DataAtualizacao" />
                    </th>
                    <th colspan="3">Ações</th>
                </tr>
            </thead>
            <tbody class="table-group-divider">
                @foreach (var item in Model.Itens)
                {
                    <tr class="align-middle">
                        <td>
                            @Html.DisplayFor(modelItem => item.Nome)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.DataCadastro)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.DataAtualizacao)
                        </td>

                        <td class="p-2 align-content-center w150px">
                            <div class="btn-group" role="group" aria-label="Botões de ação">
                                <a title="Alterar" class="btn btn@(classBotao)-primary btn-acao p-0 pt-1 pb-1" asp-action="Alterar" asp-route-id="@item.Id">
                                    <i class="fa-solid fa-lg fa-pen-to-square"></i>
                                </a>

                                <a title="Detalhes" class="btn btn@(classBotao)-success btn-acao p-0 pt-1 pb-1" asp-action="Detalhes" asp-route-id="@item.Id">
                                    <i class="fa-solid fa-lg fa-info-circle"></i>
                                </a>

                                <a possui-papel="superadmin" title="Remover" class="btn btn@(classBotao)-danger btn-acao p-0 pt-1 pb-1" asp-action="Deletar" asp-route-id="@item.Id">
                                    <i class="fa-solid fa-lg fa-trash-can"></i>
                                </a>

                                <a title="Usuários" class="btn btn@(classBotao)-secondary btn-acao p-0 pt-1 pb-1" asp-action="Usuarios" asp-route-id="@item.Id">
                                    <i class="fa-solid fa-lg fa-user-group"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    await Html.RenderPartialAsync("_PartialPaginacao", Model.Itens);
}